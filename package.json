    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.2",
    "postcss": "^8.4.6",
    "prettier": "^3.2.4",
    "sass": "^1.69.5",
    "tailwindcss": "^3.1.0",
    "axios": "^1.6.4",
    "laravel-vite-plugin": "^1.0.0",
    "vite": "^5.0.0"
  }
}
